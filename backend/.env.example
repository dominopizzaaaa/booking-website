# Local development; production must explicitly set DATABASE_URL.
DATABASE_URL=postgresql://postgres:courtly_local_dev@127.0.0.1:55432/courtly?schema=public
PORT=4000
NODE_ENV=development
# Comma-separated permitted browser origins. In production, set this to the
# canonical HTTPS Vercel URL, with no trailing slash.
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
# Canonical browser origin used to build links in transactional email. Local
# development defaults to the first APP_ORIGIN entry. Production email requires
# an explicit non-loopback HTTPS origin with no credentials, path, query, or
# fragment.
# PUBLIC_APP_ORIGIN=https://courtly.example.com
# Set false in production to disable creation of demo workspaces. When true,
# each demo visitor receives an isolated business and persistent cookie session.
DEMO_ENABLED=true
# Test harness escape hatch for large Playwright runs. It disables every API
# rate limiter only when NODE_ENV is not production; leave it unset during
# normal development and never configure it on a deployed service.
# E2E_DISABLE_RATE_LIMITS=true
# Production signup, checkout, and Family consent remain closed until both
# values match backend/src/legal-policy.ts exactly. Record accountable approval
# before setting them; a version alone never approves changed draft content.
# Current files are a review draft, so do not copy these example values into a
# production environment until the full set has actually been approved.
# LEGAL_DOCUMENTS_APPROVED_VERSION=replace-with-approved-policy-version
# LEGAL_DOCUMENTS_APPROVED_HASH=replace-with-approved-policy-set-sha256
# Named platform operators. Required to enable /admin in production. Supply a
# compact JSON array of stable id, display name, normalized email, and a bcrypt
# password hash (cost 12). Duplicate ids or emails fail configuration.
# ADMIN_OPERATORS_JSON=[{"id":"ops_alice","name":"Alice Operator","email":"alice@example.com","passwordHash":"$2b$12$replace-with-a-real-bcrypt-hash"}]
# Dedicated 32-byte base64 HMAC key for admin cookies. Generate with
# `openssl rand -base64 32`; required to enable named admin in production.
# ADMIN_SESSION_SECRET=replace-with-32-byte-base64-output
# Non-production compatibility only. Shared sessions cannot access privacy,
# safeguarding, platform chat, business deletion, or demo-purge routes.
# ADMIN_PASSWORD=replace-with-a-local-shared-secret
# Production hard-disables deletion of non-demo businesses and provides no
# environment override. Individual demo deletion and bulk demo purge remain
# available; non-production keeps individual cleanup for tests and development.
# Optional CLI seed club identity. No fixed password is used if unset.
# SEED_CLUB_EMAIL=club@example.com
# SEED_CLUB_PASSWORD=replace-with-a-strong-password
# Optional Google Places API key for venue search. The key stays on the server
# and is never sent to the browser. Without it, venues are still added by
# pasting a Google Maps link or by typing an address.
# GOOGLE_MAPS_API_KEY=replace-with-a-places-api-key

# Payment orchestration is disabled by default. "stripe" enables provider-
# backed PACKAGE and BOOKING intents; "simulated" is development/test only.
# Rentals still use their separate simulated checkout path in every mode.
# PAYMENTS_MODE=disabled
# Stripe mode requires all three values. Secret and publishable keys must both
# be test keys or both be live keys. Register the raw-body webhook endpoint at
# https://YOUR-FRONTEND-DOMAIN/api/payments/webhooks/stripe. Club connected
# accounts are provisioned outside Courtly and stored as BusinessPaymentAccount
# rows; Courtly does not currently implement Stripe Connect onboarding.
# Provider configuration is only technical readiness. Before accepting live
# funds, approve the seller/agent/GST and public-price decisions documented in
# docs/compliance/SELLER_AGENT_GST_DECISION.md.
# Stripe checkout remains closed in production unless this independently
# records approval of the current commercial decision. Legal-policy approval
# does not imply seller, payment-recipient, refund-owner, or GST approval.
# PAYMENT_COMMERCIAL_APPROVED_VERSION=replace-with-approved-commercial-version
# STRIPE_SECRET_KEY=sk_test_replace-me
# STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
# STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Transactional email is disabled by default. "capture" keeps messages in
# memory for local/test use and is rejected in production; "resend" sends
# queued student booking notifications through Resend. The sender must be on a
# verified domain. Delivery retries run inside every backend API process.
# EMAIL_PROVIDER=disabled
# EMAIL_API_KEY=re_replace-me
# EMAIL_FROM_ADDRESS=bookings@example.com
# EMAIL_FROM_NAME=Courtly
# EMAIL_REPLY_TO=support@example.com
# Dedicated versioned HMAC keyring for deriving one-time verification links
# without storing bearer tokens in the database or delivery queue. Values are
# comma-separated keyId:base64 entries and must decode to exactly 32 bytes.
# Generate each key with `openssl rand -base64 32`. Keep retired keys configured
# through the claim lifetime and maximum delivery-retry window, then select one
# current key ID. Production registration remains closed unless this keyring
# and transactional email are both ready.
# EMAIL_VERIFICATION_TOKEN_KEYS=v1:replace-with-32-byte-base64-output
# EMAIL_VERIFICATION_TOKEN_ACTIVE_KEY_ID=v1
# These settings do not authorize marketing. Marketing is hard-disabled in
# code, including for recipients without an account, and there is intentionally
# no MARKETING_ENABLED environment setting. Courtly has no approved campaign
# consent, DNC, or unsubscribe workflow; see docs/compliance/MARKETING_DNC.md.

# Family handover links are deterministic HMAC credentials so the durable
# email outbox never stores a raw or encrypted bearer token. Each value must
# decode to exactly 32 bytes. Keep old keys configured for at least the full
# seven-day claim lifetime plus the maximum delivery-retry window. Handover is
# unavailable unless email and this dedicated keyring are both configured.
# Generate a key with: openssl rand -base64 32
# FAMILY_HANDOVER_TOKEN_KEYS=v1:replace-with-32-byte-base64-output
# FAMILY_HANDOVER_TOKEN_ACTIVE_KEY_ID=v1
# Family routes default to enabled outside production and disabled in
# production. Set this explicitly to true only after the production schema,
# workers, health response, and matching frontend have passed rollout checks.
# Handover dependency readiness is reported separately by /api/health.
# FAMILY_FEATURE_ENABLED=false

# Optional personal Google Calendar integration for STUDENT and COACH accounts.
# Register this exact same-origin callback with the Google OAuth web client. Use
# the public Vercel URL in production; /api is forwarded to this backend.
# GOOGLE_CALENDAR_CLIENT_ID=replace-with-a-google-oauth-client-id
# GOOGLE_CALENDAR_CLIENT_SECRET=replace-with-a-google-oauth-client-secret
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# Token keys are comma-separated keyId:base64 entries. Each base64 value must
# decode to exactly 32 bytes; generate one with: openssl rand -base64 32
# Keep old entries during rotation, never commit real keys, and select one ID.
# CALENDAR_TOKEN_ENCRYPTION_KEYS=v1:replace-with-32-byte-base64-output
# CALENDAR_TOKEN_ACTIVE_KEY_ID=v1
