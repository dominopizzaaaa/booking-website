generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  ownerName            String
  email                String
  timezone             String                  @default("Asia/Singapore")
  currency             String                  @default("SGD")
  color                String                  @default("sage")
  tagline              String                  @default("Good coaching. Great possibilities.")
  cancellationHours    Int                     @default(24)
  /// "CLUB" routes every lesson payment through the club before it reaches a
  /// coach. "SOLO" is one coach's own practice, where the student pays the
  /// coach directly. Snapshotted onto each Booking as paymentRoute.
  kind                 String                  @default("CLUB")
  isDemo               Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  memberships          Membership[]
  instructors          Instructor[]
  locations            Location[]
  services             Service[]
  availability         Availability[]
  exceptions           AvailabilityException[]
  students             Student[]
  packages             LessonPackage[]
  bookings             Booking[]
  payments             Payment[]
  notifications        Notification[]
  accountNotifications AccountNotification[]
  rescheduleRequests   RescheduleRequest[]
  integrityFlags       IntegrityFlag[]
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String?
  /// The only role vocabulary in Courtly. "STUDENT" books lessons, "COACH"
  /// teaches them, "CLUB" is a club or academy rather than a person. This one
  /// value decides both the profile someone sees and what they may do, so
  /// there is deliberately no second role stored per membership.
  accountType          String                @default("STUDENT")
  phone                String                @default("")
  parentName           String                @default("")
  memberships          Membership[]
  sessions             AuthSession[]
  students             Student[]
  accountNotifications AccountNotification[]
  createdAt            DateTime              @default(now())
}

/// Which businesses an account belongs to. A coach has one row per club that
/// added them, plus one for their own practice; a club account has exactly
/// one. What the account may do here comes from User.accountType, so no role
/// is stored: a coach is a coach everywhere, and a club runs its own club.
model Membership {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// The club's roster entry for this coach. A club account never teaches, so
  /// it never has one; a coach's own practice does, because they teach there.
  /// SQL also pins it to businessId with a non-cascading composite foreign key.
  instructorId String?       @unique
  instructor   Instructor?   @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  sessions     AuthSession[]

  @@unique([userId, businessId])
  @@index([businessId])
}

model AuthSession {
  id                 String      @id
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembershipId String?
  activeMembership   Membership? @relation(fields: [activeMembershipId], references: [id], onDelete: SetNull)
  expiresAt          DateTime
  createdAt          DateTime    @default(now())

  @@index([expiresAt])
  @@index([userId])
  @@index([activeMembershipId])
}

model Instructor {
  id                    String                  @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId            String
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                  String
  initials              String
  color                 String                  @default("sage")
  email                 String                  @default("")
  specialty             String                  @default("")
  /// The coach's own protection window: a reschedule may not be requested or
  /// accepted once the session is closer than this many hours away.
  rescheduleNoticeHours Int                     @default(24)
  active                Boolean                 @default(true)
  membership            Membership?
  assignments           ServiceInstructor[]
  availability          Availability[]
  exceptions            AvailabilityException[]
  bookings              Booking[]
  payouts               Payment[]
  integrityFlags        IntegrityFlag[]

  // Supports the database-level composite FK that keeps a membership's
  // optional instructor inside the same business.
  @@unique([id, businessId])
  @@index([businessId])
}

model Location {
  id               String            @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  address          String            @default("")
  type             String            @default("FACILITY")
  color            String            @default("sage")
  requiresApproval Boolean           @default(false)
  travelMinutes    Int               @default(20)
  notes            String            @default("")
  /// Venue provenance. A coach or club can look a venue up on Google Maps
  /// instead of typing an address, so the place identity is stored alongside
  /// the free-text address rather than replacing it.
  source           String            @default("MANUAL")
  placeId          String            @default("")
  mapsUrl          String            @default("")
  latitude         Float?
  longitude        Float?
  active           Boolean           @default(true)
  services         ServiceLocation[]
  availability     Availability[]
  bookings         Booking[]

  // Composite target for tenant-bound scheduling relations.
  @@unique([id, businessId])
  @@index([businessId])
}

model Service {
  id            String            @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  description   String            @default("")
  category      String            @default("Tennis")
  type          String            @default("PRIVATE")
  duration      Int               @default(60)
  /// Integer minor units (cents), never a floating-point currency amount.
  price         Int               @default(8000)
  capacity      Int               @default(1)
  bufferMinutes Int               @default(0)
  noticeHours   Int               @default(2)
  color         String            @default("sage")
  active        Boolean           @default(true)
  locations     ServiceLocation[]
  bookings      Booking[]
  packages      LessonPackage[]

  // Composite target for a booking's tenant-bound service relation.
  @@unique([id, businessId])
  @@index([businessId])
}

model ServiceLocation {
  id          String              @id @default(cuid())
  serviceId   String
  /// Deferred keyed invariants keep the service and location in one business
  /// even though this assignment row has no duplicate businessId.
  service     Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Integer minor units (cents).
  price       Int
  duration    Int
  instructors ServiceInstructor[]

  @@unique([serviceId, locationId])
}

model ServiceInstructor {
  serviceLocationId String
  serviceLocation   ServiceLocation @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)
  instructorId      String
  /// The database requires this instructor to share the service location's
  /// business; API-side roster checks are an additional bookability rule.
  instructor        Instructor      @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([serviceLocationId, instructorId])
}

model Availability {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instructorId String
  /// Both scheduling resources are pinned to businessId by composite foreign
  /// keys, which remain deferred for transactional graph construction.
  instructor   Instructor @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  locationId   String
  location     Location   @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  dayOfWeek    Int
  startTime    String
  endTime      String

  @@unique([instructorId, locationId, dayOfWeek, startTime])
  @@index([businessId])
}

model AvailabilityException {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instructorId String
  /// A deferred composite foreign key pins the instructor to this business.
  instructor   Instructor @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  date         String
  reason       String     @default("Unavailable")

  @@unique([instructorId, date])
  @@index([businessId])
}

/// A student's record inside one club: what that club knows about them.
/// Their identity as a person lives on User.
model Student {
  id           String          @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId   String
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String          @default("")
  initials     String
  notes        String          @default("")
  parentName   String          @default("")
  createdAt    DateTime        @default(now())
  participants Participant[]
  packages     LessonPackage[]
  payments     Payment[]

  // Supports the database-level composite FK that keeps a payment's student
  // party inside the payment's business.
  @@unique([id, businessId])
  @@unique([businessId, email])
  @@unique([businessId, userId])
  @@index([userId])
}

model LessonPackage {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student       @relation(fields: [studentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  name         String
  serviceId    String?
  /// SQL adds a deferred, non-cascading composite tenant FK alongside this
  /// Prisma relation. It nulls only serviceId so businessId stays intact.
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  totalCredits Int
  usedCredits  Int           @default(0)
  /// Integer minor units (cents).
  price        Int
  expiresAt    DateTime
  paid         Boolean       @default(false)
  participants Participant[]
  payments     Payment[]

  @@unique([id, businessId])
  @@unique([id, studentId])
  @@index([businessId])
}

model Booking {
  id                   String                @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId           String
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId            String
  /// Deferred composite foreign keys require the service, instructor and
  /// location to belong to businessId.
  service              Service               @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  instructorId         String
  instructor           Instructor            @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  locationId           String
  location             Location              @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  startAt              DateTime
  endAt                DateTime
  duration             Int
  bufferMinutes        Int                   @default(0)
  status               String                @default("CONFIRMED")
  type                 String
  capacity             Int
  /// Integer minor units (cents), snapshotted when the booking is created.
  price                Int
  notes                String                @default("")
  address              String                @default("")
  /// Snapshot of Business.kind. "CLUB" means the club collects from the
  /// student and later pays the coach; "DIRECT" means the student pays the
  /// coach. Never derive this live: the snapshot is the booking's contractual
  /// record even though Business.kind is immutable after creation.
  paymentRoute         String                @default("DIRECT")
  /// A club may assign a student to a coach without the student accepting,
  /// but the coach must accept before the lesson is confirmed.
  coachAcceptance      String                @default("NOT_REQUIRED")
  coachRespondedAt     DateTime?
  createdByUserId      String?
  createdByRole        String                @default("STUDENT")
  recurringId          String?
  createdAt            DateTime              @default(now())
  participants         Participant[]
  payments             Payment[]
  accountNotifications AccountNotification[]
  rescheduleRequests   RescheduleRequest[]
  integrityFlags       IntegrityFlag[]

  // Supports the database-level composite FK that keeps a payment's optional
  // booking inside the same business.
  @@unique([id, businessId])
  @@index([businessId, startAt])
  @@index([instructorId, startAt, endAt])
  @@index([businessId, coachAcceptance])
}

model Participant {
  id                       String         @id @default(cuid())
  bookingId                String
  booking                  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId                String
  /// The database requires this student to share the booking's business.
  student                  Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attendance               String         @default("UNMARKED")
  paid                     Boolean        @default(false)
  /// Integer minor units (cents), snapshotted for this participant.
  price                    Int
  notes                    String         @default("")
  packageId                String?
  /// A composite relation pins package ownership to this student. Because the
  /// student is tenant-pinned to the booking, package tenancy follows too.
  package                  LessonPackage? @relation(fields: [packageId, studentId], references: [id, studentId], onDelete: NoAction, onUpdate: NoAction)
  creditConsumed           Boolean        @default(false)
  cancelledAt              DateTime?
  managementTokenHash      String?        @unique
  managementTokenExpiresAt DateTime?
  managementTokenRevokedAt DateTime?

  @@unique([bookingId, studentId])
  @@index([packageId, studentId])
}

model Payment {
  id               String         @id @default(cuid())
  businessId       String
  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Present only when this is money received from a student. Coach payouts
  /// have no student party. Including businessId in the relation prevents a
  /// ledger row from naming a student owned by another tenant.
  studentId        String?
  student          Student?       @relation(fields: [studentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  bookingId        String?
  /// A student receipt may target this booking only when the named student is
  /// one of its participants. A payment cannot target a booking and package.
  booking          Booking?       @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  packageId        String?
  /// A package receipt must name the same student who owns the package.
  package          LessonPackage? @relation(fields: [packageId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Which leg of the money path this record represents. Club lessons are
  /// STUDENT_TO_CLUB followed by CLUB_TO_COACH; a solo coach's own student
  /// pays STUDENT_TO_COACH.
  kind             String         @default("STUDENT_TO_CLUB")
  /// Set only for a CLUB_TO_COACH payout. Restrict deletion so an auditable
  /// payout can never silently lose the coach it names, and include businessId
  /// so the payee must be on this tenant's roster.
  instructorId     String?
  instructor       Instructor?    @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Integer minor units (cents).
  amount           Int
  method           String         @default("BANK_TRANSFER")
  note             String         @default("")
  paidAt           DateTime       @default(now())
  /// A recorded payment is reversed rather than deleted so the correction
  /// stays auditable. Reversed rows are excluded from every balance.
  reversedAt       DateTime?
  reversedByUserId String?
  reversedReason   String         @default("")

  @@index([businessId])
  @@index([instructorId])
  @@index([bookingId, studentId])
  @@index([packageId, studentId])
}

model Notification {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instructorId String?
  /// Drives the icon and grouping in the workspace alerts view. See
  /// notificationTypes in backend/src/notifications.ts for the vocabulary.
  type         String   @default("NOTICE")
  bookingId    String?
  title        String
  message      String
  read         Boolean  @default(false)
  actionNeeded Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([businessId])
  @@index([businessId, read])
}

// Student-facing account alerts are deliberately separate from provider
// workspace notifications. An account can therefore only read its own alerts,
// while deleting a business or booking preserves the historical alert text.
model AccountNotification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String?
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type         String
  title        String
  message      String
  read         Boolean   @default(false)
  actionNeeded Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([businessId])
  @@index([bookingId])
}

// A reschedule is a negotiation, not a unilateral edit. Either side proposes a
// new time; the other side accepts before the booking actually moves. The
// coach's rescheduleNoticeHours bounds how late a request may still be made.
model RescheduleRequest {
  id                String    @id @default(cuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId         String
  /// A deferred composite foreign key pins the request to this booking's business.
  booking           Booking   @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  /// "STUDENT", "COACH" or "CLUB". Who asked for the change.
  /// New or retargeted rows require a requester account with live authority:
  /// STUDENT requires an active participantId, while provider roles forbid one
  /// and require an active matching affiliation. Historical null requesters,
  /// later cancellation and later affiliation deactivation remain preserved.
  requestedByRole   String
  requestedByUserId String?
  /// The participant the request belongs to when a student raised it.
  participantId     String?
  proposedStartAt   DateTime
  proposedEndAt     DateTime
  originalStartAt   DateTime
  message           String    @default("")
  /// "PENDING", "ACCEPTED", "DECLINED", "WITHDRAWN" or "EXPIRED".
  status            String    @default("PENDING")
  respondedByUserId String?
  respondedAt       DateTime?
  responseMessage   String    @default("")
  createdAt         DateTime  @default(now())

  @@index([businessId, status])
  @@index([bookingId, status])
}

// Club safeguard. A coach and a student who first met through a club, and who
// later book privately outside it, are surfaced to that club for review rather
// than being blocked: the platform reports, a human decides.
model IntegrityFlag {
  id                  String      @id @default(cuid())
  /// The club that introduced the pair and may have been bypassed.
  businessId          String
  business            Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// The club's own roster entry for the coach involved.
  instructorId        String?
  instructor          Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  coachUserId         String
  studentUserId       String
  coachName           String
  studentName         String
  /// The private booking outside the club that triggered the flag.
  bookingId           String?
  booking             Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  outsideBusinessId   String?
  outsideBusinessName String      @default("")
  type                String      @default("PRIVATE_SESSION_AFTER_CLUB")
  /// "OPEN", "REVIEWING", "DISMISSED" or "UPHELD".
  status              String      @default("OPEN")
  detail              String      @default("")
  occurrences         Int         @default(1)
  firstSeenAt         DateTime    @default(now())
  lastSeenAt          DateTime    @default(now())
  resolvedAt          DateTime?
  resolvedByUserId    String?
  resolutionNote      String      @default("")

  @@unique([businessId, coachUserId, studentUserId, type])
  @@index([businessId, status])
}
