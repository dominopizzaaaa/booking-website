generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Short-lived, privacy-preserving request counters shared by all API replicas.
/// keyHash is a namespaced HMAC-SHA-256 digest; raw IP/account identifiers are
/// never persisted. Expired rows are removed opportunistically in bounded sets.
model RateLimitCounter {
  namespace String
  keyHash   String
  hits      BigInt
  resetAt   DateTime @db.Timestamptz(3)

  @@id([namespace, keyHash])
  @@index([resetAt])
}

model Business {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  ownerName             String
  email                 String
  timezone              String                  @default("Asia/Singapore")
  currency              String                  @default("SGD")
  color                 String                  @default("sage")
  tagline               String                  @default("Good coaching. Great possibilities.")
  cancellationHours     Int                     @default(24)
  /// Commercial identity shown before checkout and retained on receipts.
  /// Empty values mean the club has not completed payment-readiness setup;
  /// Courtly never invents a registration or GST position.
  legalName             String                  @default("")
  registrationNumber    String?
  supportEmail          String                  @default("")
  supportAddress        String                  @default("")
  gstRegistrationStatus String                  @default("NOT_DECLARED")
  gstRegistrationNumber String?
  pricesIncludeGst      Boolean?
  /// Public club profile shown before account creation on the booking page
  /// and in Explore. Contact values are optional and never inferred.
  description           String                  @default("")
  publicPhone           String                  @default("")
  websiteUrl            String                  @default("")
  /// "CLUB" routes every new lesson payment through the club before it reaches
  /// a coach. "SOLO" survives only on retained historical records. The value
  /// was snapshotted onto each Booking as paymentRoute.
  kind                  String                  @default("CLUB")
  /// Practices that predate the marketplace remain visible for history but
  /// cannot accept new commercial activity. This never rewrites kind or a
  /// booking's contractual paymentRoute.
  legacyReadOnly        Boolean                 @default(false)
  isDemo                Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  memberships           Membership[]
  instructors           Instructor[]
  locations             Location[]
  services              Service[]
  availability          Availability[]
  exceptions            AvailabilityException[]
  students              Student[]
  packages              LessonPackage[]
  bookings              Booking[]
  payments              Payment[]
  notifications         Notification[]
  accountNotifications  AccountNotification[]
  rescheduleRequests    RescheduleRequest[]
  integrityFlags        IntegrityFlag[]
  venueUnits            VenueUnit[]
  venueOpeningHours     VenueOpeningHour[]
  venueReservations     VenueReservation[]
  packageOffers         PackageOffer[]
  paymentIntents        PaymentIntent[]
  paymentReceipts       PaymentReceipt[]
  chatThreads           ChatThread[]
  sessionProposals      SessionProposal[]
  coachInvitations      CoachInvitation[]
  staffAccesses         ClubStaffAccess[]
  staffInvitations      ClubStaffInvitation[]
  auditEvents           BusinessAuditEvent[]
  bookingSeries         BookingSeries[]
  venueUnitAllocations  VenueUnitAllocation[]
  outboundDeliveries    OutboundDelivery[]
  paymentAccount        BusinessPaymentAccount?
  paymentProviderEvents PaymentProviderEvent[]
  paymentRefunds        PaymentRefund[]
  paymentRiskCases      PaymentRiskCase[]
  chatSafetyReports     ChatSafetyReport[]
  sessionFeedback       SessionFeedback[]
  waitlistEntries       WaitlistEntry[]
  packageCreditEvents   PackageCreditEvent[]
  trainingGroups        TrainingGroup[]
  trainingGroupMembers  TrainingGroupMember[]
  favoritedBy           FavoriteClub[]
  funnelCounters        ClubFunnelCounter[]

  @@index([kind, isDemo, slug])
}

model User {
  id                           String                    @id @default(cuid())
  name                         String
  /// Private legal identity. Existing accounts are backfilled from name; name
  /// remains the display identity used throughout the product.
  legalName                    String
  /// A calendar date rather than a timestamp. Null means the legacy account
  /// has not completed the one-time age review. Once set, SQL keeps it fixed.
  dateOfBirth                  DateTime?                 @db.Date
  /// Guardian-managed children do not need synthetic credentials or contact
  /// addresses. PostgreSQL uniqueness still applies to every non-null email.
  email                        String?                   @unique
  emailVerifiedAt              DateTime?
  /// Versioned signup evidence. These values record acceptance of the account
  /// terms and acknowledgement of the general privacy notice; child guardian
  /// consent remains separate in ChildConsentRecord.
  termsAcceptedVersion         String?
  termsAcceptedAt              DateTime?
  privacyNoticeAcceptedVersion String?
  privacyNoticeAcceptedAt      DateTime?
  /// Content-derived identifier for the complete policy set presented at
  /// signup. Version labels alone are not acceptance evidence.
  signupPolicySetHash          String?
  /// Public account handle. SQL enforces canonical lowercase ASCII
  /// [a-z0-9_] content and the 3-30 character boundary.
  username                     String                    @unique
  sports                       String[]                  @default([])
  passwordHash                 String?
  /// The only role vocabulary in Courtly. "STUDENT" books lessons, "COACH"
  /// teaches them, "CLUB" is a club or academy rather than a person. This one
  /// value decides both the profile someone sees and what they may do, so
  /// there is deliberately no second role stored per membership.
  accountType                  String                    @default("STUDENT")
  /// SELF accounts authenticate and act for themselves. GUARDIAN_MANAGED is
  /// reserved for private child identities operated through active links.
  accountControl               String                    @default("SELF")
  accountStatus                String                    @default("ACTIVE")
  /// Safeguarding containment is deliberately separate from child-account
  /// policy state. This bounded control restricts direct account chat only.
  safetyStatus                 String                    @default("ACTIVE")
  profileVisibility            String                    @default("PUBLIC")
  phone                        String                    @default("")
  parentName                   String                    @default("")
  /// Portable coaching profile. Only COACH accounts may set these values, and
  /// only those accounts expose them on public booking pages. Qualifications
  /// are self-reported; Courtly does not verify them.
  bio                          String                    @default("")
  languages                    String[]                  @default([])
  coachingLevels               String[]                  @default([])
  coachingAgeGroups            String[]                  @default([])
  qualifications               String[]                  @default([])
  coachingSince                Int?
  memberships                  Membership[]
  sessions                     AuthSession[]
  students                     Student[]
  accountNotifications         AccountNotification[]
  calendarConnection           CalendarConnection?
  calendarOAuthAttempts        CalendarOAuthAttempt[]
  venueReservations            VenueReservation[]
  paymentIntents               PaymentIntent[]
  paymentReceipts              PaymentReceipt[]
  chatThreadMemberships        ChatThreadMember[]        @relation("ChatThreadMemberUser")
  chatMembersAdded             ChatThreadMember[]        @relation("ChatThreadMemberAddedBy")
  acceptedCoachInvites         CoachInvitation[]         @relation("CoachInvitationAcceptedBy")
  staffAccesses                ClubStaffAccess[]
  acceptedStaffInvites         ClubStaffInvitation[]     @relation("ClubStaffInvitationAcceptedBy")
  notificationPreference       NotificationPreference?
  outboundDeliveries           OutboundDelivery[]
  paymentRefundRequests        PaymentRefund[]           @relation("PaymentRefundRequestedBy")
  ownedPaymentRiskCases        PaymentRiskCase[]         @relation("PaymentRiskCaseOwner")
  guardianLinks                GuardianChildLink[]       @relation("GuardianChildLinkGuardian")
  childLinks                   GuardianChildLink[]       @relation("GuardianChildLinkChild")
  guardianConsentRecords       ChildConsentRecord[]      @relation("ChildConsentRecordGuardian")
  childConsentRecords          ChildConsentRecord[]      @relation("ChildConsentRecordChild")
  initiatedHandovers           ChildAccountHandover[]    @relation("ChildAccountHandoverInitiator")
  childHandovers               ChildAccountHandover[]    @relation("ChildAccountHandoverChild")
  signupAcceptanceEvidence     SignupAcceptanceEvidence?
  emailVerificationClaims      EmailVerificationClaim[]
  passwordResetClaims          PasswordResetClaim[]
  emailChangeClaims            EmailChangeClaim[]
  mfaCredential                AccountMfaCredential?
  mfaEnrollments               AccountMfaEnrollment[]
  mfaRecoveryCodes             AccountMfaRecoveryCode[]
  mfaLoginChallenges           MfaLoginChallenge[]
  accountSecurityEvents        AccountSecurityEvent[]
  privacyRequests              PrivacyRequest[]          @relation("PrivacyRequestSubject")
  chatBlocksInitiated          ChatAccountBlock[]        @relation("ChatAccountBlockBlocker")
  chatBlocksReceived           ChatAccountBlock[]        @relation("ChatAccountBlockBlocked")
  chatSafetyReportsFiled       ChatSafetyReport[]        @relation("ChatSafetyReportReporter")
  chatSafetyReportsAgainst     ChatSafetyReport[]        @relation("ChatSafetyReportSubject")
  chatSafetyReportsAssigned    ChatSafetyReport[]        @relation("ChatSafetyReportClubAssignee")
  chatSafetyAuditEvents        ChatSafetyAuditEvent[]    @relation("ChatSafetyAuditActor")
  feedbackAuthored             SessionFeedback[]         @relation("SessionFeedbackAuthor")
  favoriteClubs                FavoriteClub[]
  createdAt                    DateTime                  @default(now())
}

/// Append-only proof of the exact policy set accepted at signup. It cannot be
/// changed or deleted independently, but follows an authorized User deletion.
model SignupAcceptanceEvidence {
  id                   String   @id
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion         String
  privacyNoticeVersion String
  policySetHash        String
  acceptedAt           DateTime
  createdAt            DateTime @default(now())
}

/// Digest-only, expiring proof used to verify that a self-managed account
/// controls its signup email address. The raw bearer token is never stored.
model EmailVerificationClaim {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  tokenKeyId String
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Digest-only, expiring password-recovery bearer. Generic issuance responses
/// prevent this table from becoming an account-enumeration oracle.
model PasswordResetClaim {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  tokenKeyId String
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Verification of the destination address precedes the atomic email swap.
/// Completion revokes every browser session and supersedes other live claims.
model EmailChangeClaim {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  tokenKeyId String
  oldEmail   String
  newEmail   String
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([newEmail, expiresAt])
  @@index([expiresAt])
}

/// The RFC 6238 secret is stored only as a versioned AES-256-GCM envelope. An
/// incomplete row is a bounded enrollment, not an enabled second factor.
model AccountMfaCredential {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCiphertext String
  enabledAt        DateTime?
  lastUsedStep     BigInt?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Short-lived pending authenticator setup. Starting setup never replaces an
/// already-enabled credential; only a confirmed enrollment may become active.
model AccountMfaEnrollment {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretCiphertext String
  attempts         Int       @default(0)
  expiresAt        DateTime
  consumedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Recovery values are shown once and retained only as keyed digests.
model AccountMfaRecoveryCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String    @unique
  keyId      String
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

/// Short-lived bridge between a valid password and MFA verification. Only the
/// random bearer digest is stored; successful consumption creates a session.
model MfaLoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Append-only, secret-free account-security history. subjectUserIdSnapshot
/// remains after an authorized account deletion while the optional relation is
/// nulled. That FK-driven nullification is the only permitted row update.
model AccountSecurityEvent {
  id                    String   @id @default(cuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjectUserIdSnapshot String
  eventType             String
  sessionPublicId       String?
  metadata              Json
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
  @@index([subjectUserIdSnapshot, createdAt])
  @@index([eventType, createdAt])
}

/// A single data-subject request/case. The subject can track access,
/// correction, erasure, restriction, consent withdrawal, or an objection.
/// Resolution is always a reviewed decision, including partial refusal and
/// retention/legal-hold grounds; creating a case does not pretend fulfilment.
model PrivacyRequest {
  id                   String                @id @default(cuid())
  subjectUserId        String
  subject              User                  @relation("PrivacyRequestSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  type                 String
  status               String                @default("RECEIVED")
  details              String                @default("")
  correctionFields     Json?
  submittedAt          DateTime              @default(now())
  acknowledgementDueAt DateTime
  responseDueAt        DateTime
  acknowledgedAt       DateTime?
  identityVerifiedAt   DateTime?
  delayNoticeAt        DateTime?
  delayReason          String?
  estimatedResponseAt  DateTime?
  legalHold            Boolean               @default(false)
  legalHoldReason      String?
  decision             String?
  decisionReason       String?
  completedAt          DateTime?
  cancelledAt          DateTime?
  updatedAt            DateTime              @updatedAt
  events               PrivacyRequestEvent[]

  @@index([subjectUserId, submittedAt])
  @@index([status, responseDueAt])
}

/// Append-only operational history. Actor identity is snapshotted so a
/// later account anonymisation cannot rewrite who made a compliance decision.
model PrivacyRequestEvent {
  id                 String         @id @default(cuid())
  requestId          String
  request            PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  action             String
  actorKind          String
  actorUserId        String?
  actorNameSnapshot  String
  actorEmailSnapshot String
  fromStatus         String?
  toStatus           String?
  note               String         @default("")
  metadata           Json?
  createdAt          DateTime       @default(now())

  @@index([requestId, createdAt])
}

/// A guardian's explicit authority over a global child identity. This is not
/// a business Membership and several guardians may hold independent links.
model GuardianChildLink {
  id               String               @id @default(cuid())
  guardianUserId   String
  guardian         User                 @relation("GuardianChildLinkGuardian", fields: [guardianUserId], references: [id], onDelete: Restrict)
  childUserId      String
  child            User                 @relation("GuardianChildLinkChild", fields: [childUserId], references: [id], onDelete: Restrict)
  relationshipType String
  status           String               @default("ACTIVE")
  permissions      String[]             @default(["PROFILE_MANAGE", "BOOKINGS_MANAGE", "CREDENTIAL_RESET", "PRIVACY_MANAGE", "DATA_EXPORT", "CONSENT_MANAGE", "DELETION_REQUEST", "HANDOVER_MANAGE"])
  createdAt        DateTime             @default(now())
  activatedAt      DateTime             @default(now())
  withdrawnAt      DateTime?
  endedAt          DateTime?
  updatedAt        DateTime             @updatedAt
  consentRecords   ChildConsentRecord[]

  @@unique([guardianUserId, childUserId])
  @@unique([id, guardianUserId, childUserId], map: "GuardianChildLink_identity_key")
  @@index([guardianUserId, status])
  @@index([childUserId, status])
}

/// Immutable evidence of guardian consent and family-account lifecycle events.
/// State changes append a new row; SQL rejects UPDATE and DELETE.
model ChildConsentRecord {
  id                   String            @id @default(cuid())
  linkId               String
  link                 GuardianChildLink @relation(fields: [linkId, guardianUserId, childUserId], references: [id, guardianUserId, childUserId], onDelete: Restrict, onUpdate: NoAction, map: "ChildConsentRecord_linkId_guardianUserId_childUserId_fkey")
  guardianUserId       String
  guardian             User              @relation("ChildConsentRecordGuardian", fields: [guardianUserId], references: [id], onDelete: Restrict)
  childUserId          String
  child                User              @relation("ChildConsentRecordChild", fields: [childUserId], references: [id], onDelete: Restrict)
  /// Database-assigned global append order. Latest state is selected within
  /// the link by this value; the insert trigger replaces this placeholder.
  sequence             Int               @default(0)
  eventType            String
  relationshipType     String
  privacyPolicyVersion String
  permissions          String[]
  metadata             Json?
  createdAt            DateTime          @default(now())

  @@unique([linkId, sequence], map: "ChildConsentRecord_linkId_sequence_key")
  @@index([childUserId, createdAt])
  @@index([guardianUserId, createdAt])
}

/// A one-time invitation for a guardian-managed child to take control of their
/// own account. The raw token is never stored; only its unique digest remains.
model ChildAccountHandover {
  id                        String    @id @default(cuid())
  childUserId               String
  child                     User      @relation("ChildAccountHandoverChild", fields: [childUserId], references: [id], onDelete: Restrict)
  initiatedByGuardianUserId String
  initiatedByGuardian       User      @relation("ChildAccountHandoverInitiator", fields: [initiatedByGuardianUserId], references: [id], onDelete: Restrict, map: "ChildAccountHandover_initiatedByGuardianUserId_fkey")
  destinationEmail          String
  tokenHash                 String    @unique
  status                    String    @default("PENDING")
  expiresAt                 DateTime
  initiatedAt               DateTime  @default(now())
  lastSentAt                DateTime  @default(now())
  completedAt               DateTime?
  cancelledAt               DateTime?

  @@index([childUserId, status])
  @@index([initiatedByGuardianUserId, initiatedAt], map: "ChildHandover_initiator_initiatedAt_idx")
  @@index([destinationEmail, status])
}

/// Which businesses an account belongs to. A coach has one row per club that
/// added them; a club account has exactly one. Retained SOLO memberships are
/// historical only. What the account may do here comes from User.accountType,
/// so no role is stored: a coach is a coach everywhere, and a club runs itself.
model Membership {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// The club's roster entry for this coach. A club account never teaches, so
  /// it never has one. Historical SOLO rows may retain their original coach.
  /// SQL also pins it to businessId with a non-cascading composite foreign key.
  instructorId      String?            @unique
  instructor        Instructor?        @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  sessions          AuthSession[]
  chatThreadMembers ChatThreadMember[]

  @@unique([userId, businessId])
  @@index([businessId])
}

/// A club-issued, email-bound invitation. The raw token is shown once; only
/// its digest is retained. Acceptance creates the normal Membership and
/// Instructor records, so all ongoing permissions still come from them.
model CoachInvitation {
  id                    String    @id @default(cuid())
  businessId            String
  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email                 String
  tokenHash             String    @unique
  rescheduleNoticeHours Int       @default(24)
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedByUserId      String?
  acceptedBy            User?     @relation("CoachInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([email, expiresAt])
}

model AuthSession {
  id                    String                 @id
  publicId              String                 @unique @default(uuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembershipId    String?
  activeMembership      Membership?            @relation(fields: [activeMembershipId], references: [id], onDelete: SetNull)
  activeStaffAccessId   String?
  activeStaffAccess     ClubStaffAccess?       @relation(fields: [activeStaffAccessId], references: [id], onDelete: SetNull)
  expiresAt             DateTime
  createdAt             DateTime               @default(now())
  lastSeenAt            DateTime               @default(now())
  recentAuthAt          DateTime?
  userAgent             String?
  calendarOAuthAttempts CalendarOAuthAttempt[]

  @@index([expiresAt])
  @@index([userId])
  @@index([activeMembershipId])
  @@index([activeStaffAccessId])
}

/// A named person's explicit, least-privilege authority to operate one club.
/// This stays separate from Membership, which remains an affiliation.
model ClubStaffAccess {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLevel     String
  permissions     String[]
  active          Boolean       @default(true)
  invitedByUserId String?
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sessions        AuthSession[]

  @@unique([businessId, userId])
  @@index([userId, active])
  @@index([businessId, active])
}

/// Email-bound invitation for named operational access. Acceptance never
/// changes account type and never creates an Instructor.
model ClubStaffInvitation {
  id               String    @id @default(cuid())
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email            String
  tokenHash        String    @unique
  accessLevel      String
  permissions      String[]
  invitedByUserId  String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  acceptedBy       User?     @relation("ClubStaffInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  revokedByUserId  String?
  createdAt        DateTime  @default(now())

  @@index([businessId, email])
  @@index([email, expiresAt])
}

/// Immutable actor snapshots for sensitive club mutations.
model BusinessAuditEvent {
  id                       String   @id @default(cuid())
  businessId               String
  business                 Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorUserId              String?
  actorName                String
  actorEmail               String
  actorAccountType         String
  actorAccessKind          String
  actorStaffAccessId       String?
  actorAccessLevel         String?
  actorPermissionsSnapshot String[]
  action                   String
  resourceType             String
  resourceId               String?
  summary                  String
  metadata                 Json
  requestId                String?
  createdAt                DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, resourceType, resourceId])
  @@index([actorUserId, createdAt])
}

model Instructor {
  id                    String                  @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId            String
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                  String
  initials              String
  color                 String                  @default("sage")
  email                 String                  @default("")
  specialty             String                  @default("")
  /// The coach's own protection window: a reschedule may not be requested or
  /// accepted once the session is closer than this many hours away.
  rescheduleNoticeHours Int                     @default(24)
  active                Boolean                 @default(true)
  membership            Membership?
  assignments           ServiceInstructor[]
  availability          Availability[]
  exceptions            AvailabilityException[]
  bookings              Booking[]
  payouts               Payment[]
  integrityFlags        IntegrityFlag[]
  sessionProposals      SessionProposal[]

  // Supports the database-level composite FK that keeps a membership's
  // optional instructor inside the same business.
  @@unique([id, businessId])
  @@index([businessId])
}

model Location {
  id                         String                  @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId                 String
  business                   Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                       String
  address                    String                  @default("")
  type                       String                  @default("FACILITY")
  color                      String                  @default("sage")
  requiresApproval           Boolean                 @default(false)
  travelMinutes              Int                     @default(20)
  notes                      String                  @default("")
  /// Public neighbourhood or region label used by Explore search, such as
  /// "Tampines · East". Free text chosen by the club; never geocoded.
  area                       String                  @default("")
  /// Venue provenance. A coach or club can look a venue up on Google Maps
  /// instead of typing an address, so the place identity is stored alongside
  /// the free-text address rather than replacing it.
  source                     String                  @default("MANUAL")
  placeId                    String                  @default("")
  mapsUrl                    String                  @default("")
  latitude                   Float?
  longitude                  Float?
  active                     Boolean                 @default(true)
  /// Rental configuration is catalog state. Reservations snapshot duration
  /// and price, so later edits never rewrite an existing rental contract.
  sport                      String                  @default("")
  rentalEnabled              Boolean                 @default(false)
  rentalUnitLabel            String                  @default("Court")
  rentalPrice                Int                     @default(0)
  rentalStartInterval        Int                     @default(60)
  rentalMinDuration          Int                     @default(60)
  rentalBookingIncrement     Int                     @default(60)
  rentalMaxDuration          Int                     @default(180)
  rentalNoticeHours          Int                     @default(2)
  rentalAdvanceDays          Int                     @default(60)
  rentalCancellationHours    Int                     @default(24)
  /// When enabled, coached classes reserve one active VenueUnit. This stays
  /// independent from whether inventory is offered for public rental.
  classUnitSchedulingEnabled Boolean                 @default(false)
  rules                      String                  @default("")
  amenities                  String                  @default("")
  services                   ServiceLocation[]
  availability               Availability[]
  bookings                   Booking[]
  venueUnits                 VenueUnit[]
  openingHours               VenueOpeningHour[]
  reservations               VenueReservation[]
  packageOfferLocations      PackageOfferLocation[]
  lessonPackageLocations     LessonPackageLocation[]
  sessionProposals           SessionProposal[]
  venueUnitAllocations       VenueUnitAllocation[]

  // Composite target for tenant-bound scheduling relations.
  @@unique([id, businessId])
  @@index([businessId])
}

/// One independently reservable court, pitch or other resource at a rental
/// location. The composite location relation prevents cross-club inventory.
model VenueUnit {
  id           String                @id @default(cuid())
  businessId   String
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location              @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  name         String
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  reservations VenueReservation[]
  allocations  VenueUnitAllocation[]

  @@unique([id, businessId])
  @@unique([id, locationId, businessId])
  @@unique([locationId, name])
  @@index([businessId])
  @@index([locationId])
}

/// Recurring local wall-clock availability for a rental location. Time zone
/// interpretation comes from Business.timezone, never from the server locale.
model VenueOpeningHour {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  dayOfWeek  Int
  startTime  String
  endTime    String

  @@unique([locationId, dayOfWeek, startTime])
  @@index([businessId])
  @@index([locationId])
}

/// A student's reservation of one venue unit. Duration, price and payment
/// state are contractual snapshots; cancelled rows remain for audit history.
model VenueReservation {
  id             String                @id @default(cuid())
  businessId     String
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location              @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  unitId         String
  unit           VenueUnit             @relation(fields: [unitId, locationId, businessId], references: [id, locationId, businessId], onDelete: Restrict, onUpdate: NoAction)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  startAt        DateTime
  endAt          DateTime
  duration       Int
  /// Integer minor units (cents), snapshotted when the reservation is made.
  price          Int
  status         String                @default("CONFIRMED")
  paymentStatus  String                @default("UNPAID")
  packageId      String?
  package        LessonPackage?        @relation(fields: [packageId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  creditConsumed Boolean               @default(false)
  notes          String                @default("")
  createdAt      DateTime              @default(now())
  cancelledAt    DateTime?
  paymentIntents PaymentIntent[]
  allocations    VenueUnitAllocation[]

  @@unique([id, businessId])
  @@index([businessId, startAt])
  @@index([locationId, startAt])
  @@index([unitId, startAt, endAt])
  @@index([userId, startAt])
  @@index([packageId])
}

model Service {
  id               String                 @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId       String
  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String
  description      String                 @default("")
  category         String                 @default("Tennis")
  type             String                 @default("PRIVATE")
  duration         Int                    @default(60)
  /// Integer minor units (cents), never a floating-point currency amount.
  price            Int                    @default(8000)
  capacity         Int                    @default(1)
  bufferMinutes    Int                    @default(0)
  noticeHours      Int                    @default(2)
  color            String                 @default("sage")
  active           Boolean                @default(true)
  locations        ServiceLocation[]
  bookings         Booking[]
  packages         LessonPackage[]
  packageOffers    PackageOfferService[]
  packageScopes    LessonPackageService[]
  sessionProposals SessionProposal[]

  // Composite target for a booking's tenant-bound service relation.
  @@unique([id, businessId])
  @@index([businessId])
}

model ServiceLocation {
  id          String              @id @default(cuid())
  serviceId   String
  /// Deferred keyed invariants keep the service and location in one business
  /// even though this assignment row has no duplicate businessId.
  service     Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  /// Integer minor units (cents).
  price       Int
  duration    Int
  instructors ServiceInstructor[]

  @@unique([serviceId, locationId])
}

model ServiceInstructor {
  serviceLocationId String
  serviceLocation   ServiceLocation @relation(fields: [serviceLocationId], references: [id], onDelete: Cascade)
  instructorId      String
  /// The database requires this instructor to share the service location's
  /// business; API-side roster checks are an additional bookability rule.
  instructor        Instructor      @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([serviceLocationId, instructorId])
}

/// A live marketplace product. Purchased LessonPackage rows copy these
/// service and rental-location scopes so later offer edits cannot narrow an
/// entitlement the student already bought.
model PackageOffer {
  id              String                 @id @default(cuid())
  businessId      String
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String                 @default("")
  /// Integer minor units (cents), never a floating-point currency amount.
  price           Int
  totalCredits    Int
  validityDays    Int
  active          Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  services        PackageOfferService[]
  rentalLocations PackageOfferLocation[]
  packages        LessonPackage[]
  paymentIntents  PaymentIntent[]

  @@unique([id, businessId])
  @@index([businessId, active])
}

model PackageOfferService {
  offerId    String
  businessId String
  offer      PackageOffer @relation(fields: [offerId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  serviceId  String
  service    Service      @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)

  @@id([offerId, serviceId])
  @@index([serviceId, businessId])
}

model PackageOfferLocation {
  offerId    String
  businessId String
  offer      PackageOffer @relation(fields: [offerId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  locationId String
  location   Location     @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)

  @@id([offerId, locationId])
  @@index([locationId, businessId])
}

model Availability {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instructorId String
  /// Both scheduling resources are pinned to businessId by composite foreign
  /// keys, which remain deferred for transactional graph construction.
  instructor   Instructor @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  locationId   String
  location     Location   @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  dayOfWeek    Int
  startTime    String
  endTime      String

  @@unique([instructorId, locationId, dayOfWeek, startTime])
  @@index([businessId])
}

model AvailabilityException {
  id           String     @id @default(cuid())
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instructorId String
  /// A deferred composite foreign key pins the instructor to this business.
  instructor   Instructor @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  date         String
  reason       String     @default("Unavailable")

  @@unique([instructorId, date])
  @@index([businessId])
}

/// A student's record inside one club: what that club knows about them.
/// Their identity as a person lives on User.
model Student {
  id                   String                @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId           String
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  name                 String
  /// Linked managed children may have no direct email address.
  email                String?
  phone                String                @default("")
  initials             String
  notes                String                @default("")
  parentName           String                @default("")
  createdAt            DateTime              @default(now())
  participants         Participant[]
  packages             LessonPackage[]
  payments             Payment[]
  seriesMembers        BookingSeriesMember[]
  waitlist             WaitlistEntry[]
  trainingGroupMembers TrainingGroupMember[]

  // Supports the database-level composite FK that keeps a payment's student
  // party inside the payment's business.
  @@unique([id, businessId])
  @@unique([businessId, email])
  @@unique([businessId, userId])
  @@index([userId])
}

model LessonPackage {
  id                   String                  @id @default(cuid())
  businessId           String
  business             Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  studentId            String
  student              Student                 @relation(fields: [studentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Optional live-offer provenance. The joins below are the immutable scope
  /// snapshot used to authorize credits after the offer changes or retires.
  offerId              String?
  offer                PackageOffer?           @relation(fields: [offerId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Set by a deferred database trigger after an offer-backed package and all
  /// of its scope rows have been created atomically. Sealed scopes cannot be
  /// edited independently from the historical purchase.
  scopeSnapshotSealed  Boolean                 @default(false)
  name                 String
  serviceId            String?
  /// SQL adds a deferred, non-cascading composite tenant FK alongside this
  /// Prisma relation. It nulls only serviceId so businessId stays intact.
  service              Service?                @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  totalCredits         Int
  usedCredits          Int                     @default(0)
  /// Integer minor units (cents).
  price                Int
  expiresAt            DateTime
  paid                 Boolean                 @default(false)
  participants         Participant[]
  payments             Payment[]
  services             LessonPackageService[]
  rentalLocations      LessonPackageLocation[]
  reservations         VenueReservation[]
  paymentIntents       PaymentIntent[]
  creditEvents         PackageCreditEvent[]
  accountNotifications AccountNotification[]

  @@unique([id, businessId])
  @@unique([id, studentId])
  @@index([businessId])
  @@index([offerId, businessId])
}

model LessonPackageService {
  packageId  String
  businessId String
  package    LessonPackage @relation(fields: [packageId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  serviceId  String
  service    Service       @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)

  @@id([packageId, serviceId])
  @@index([serviceId, businessId])
}

model LessonPackageLocation {
  packageId  String
  businessId String
  package    LessonPackage @relation(fields: [packageId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  locationId String
  location   Location      @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)

  @@id([packageId, locationId])
  @@index([locationId, businessId])
}

model Booking {
  id                   String                    @id @default(cuid())
  /// Tenant ownership is immutable after creation at the database boundary.
  businessId           String
  business             Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId            String
  /// Deferred composite foreign keys require the service, instructor and
  /// location to belong to businessId.
  service              Service                   @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  instructorId         String
  instructor           Instructor                @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  locationId           String
  location             Location                  @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  startAt              DateTime
  endAt                DateTime
  duration             Int
  bufferMinutes        Int                       @default(0)
  status               String                    @default("CONFIRMED")
  type                 String
  capacity             Int
  /// Integer minor units (cents), snapshotted when the booking is created.
  price                Int
  notes                String                    @default("")
  address              String                    @default("")
  /// Snapshot of Business.kind. "CLUB" means the club collects from the
  /// student and later pays the coach; "DIRECT" means the student pays the
  /// coach. Never derive this live: the snapshot is the booking's contractual
  /// record even though Business.kind is immutable after creation.
  paymentRoute         String                    @default("CLUB")
  /// A club may assign a student to a coach without the student accepting,
  /// but the coach must accept before the lesson is confirmed.
  coachAcceptance      String                    @default("NOT_REQUIRED")
  coachRespondedAt     DateTime?
  createdByUserId      String?
  createdByRole        String                    @default("STUDENT")
  recurringId          String?
  seriesId             String?
  seriesPosition       Int?
  series               BookingSeries?            @relation(fields: [seriesId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Immutable resource policy selected when the booking is created.
  venueRequirement     String                    @default("NONE")
  venueApproval        String                    @default("NOT_REQUIRED")
  /// Monotonic source revision used to coalesce asynchronous calendar work.
  /// Every calendar-relevant mutation increments this value in the same
  /// transaction that queues its synchronization job.
  calendarRevision     Int                       @default(0)
  createdAt            DateTime                  @default(now())
  participants         Participant[]
  payments             Payment[]
  accountNotifications AccountNotification[]
  rescheduleRequests   RescheduleRequest[]
  integrityFlags       IntegrityFlag[]
  calendarProjections  CalendarEventProjection[]
  calendarSyncJob      CalendarSyncJob?
  chatThread           ChatThread?
  proposalResponses    SessionProposalResponse[]
  venueUnitAllocations VenueUnitAllocation[]
  outboundDeliveries   OutboundDelivery[]
  chatSafetyReports    ChatSafetyReport[]
  sessionFeedback      SessionFeedback[]
  waitlistEntries      WaitlistEntry[]

  // Supports the database-level composite FK that keeps a payment's optional
  // booking inside the same business.
  @@unique([id, businessId])
  @@unique([seriesId, seriesPosition])
  @@index([businessId, startAt])
  @@index([instructorId, startAt, endAt])
  @@index([businessId, coachAcceptance])
  @@index([businessId, seriesId, startAt])
}

/// A finite, explicit set of bookings created together. Individual bookings
/// and participants remain authoritative for lifecycle and money.
model BookingSeries {
  id              String                @id @default(cuid())
  businessId      String
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String                @default("")
  createdByRole   String
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  bookings        Booking[]
  members         BookingSeriesMember[]

  @@unique([id, businessId])
  @@index([businessId, createdAt])
}

/// The future roster template for a series. Per-occurrence participation is
/// represented by Participant so attendance and payments remain exact.
model BookingSeriesMember {
  id         String        @id @default(cuid())
  businessId String
  seriesId   String
  series     BookingSeries @relation(fields: [seriesId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  studentId  String
  student    Student       @relation(fields: [studentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  active     Boolean       @default(true)
  joinedAt   DateTime      @default(now())
  removedAt  DateTime?

  @@unique([seriesId, studentId])
  @@index([businessId, studentId])
}

/// Canonical occupancy ledger shared by coached classes and rentals. Released
/// rows remain as operational history.
model VenueUnitAllocation {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location          @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  unitId        String
  unit          VenueUnit         @relation(fields: [unitId, locationId, businessId], references: [id, locationId, businessId], onDelete: Restrict, onUpdate: NoAction)
  bookingId     String?
  booking       Booking?          @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  reservationId String?
  reservation   VenueReservation? @relation(fields: [reservationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  startAt       DateTime
  endAt         DateTime
  status        String            @default("ACTIVE")
  source        String
  unitName      String
  createdAt     DateTime          @default(now())
  releasedAt    DateTime?

  @@index([unitId, startAt, endAt])
  @@index([bookingId])
  @@index([reservationId])
}

/// One Google Calendar grant belongs to one global person, independently of
/// any club workspace. Secrets are authenticated-encryption envelopes; the
/// database never stores an OAuth token in plaintext.
model CalendarConnection {
  id                     String                    @id @default(cuid())
  userId                 String                    @unique
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider               String                    @default("GOOGLE")
  providerAccountId      String
  providerEmail          String
  calendarTimeZone       String                    @default("UTC")
  accessTokenCiphertext  String
  refreshTokenCiphertext String?
  accessTokenExpiresAt   DateTime
  status                 String                    @default("ACTIVE")
  syncEnabled            Boolean                   @default(true)
  busyCheckEnabled       Boolean                   @default(false)
  lastErrorCode          String?
  lastSyncedAt           DateTime?
  busyLastRefreshedAt    DateTime?
  busyRefreshAfter       DateTime                  @default(now())
  busyRefreshFailures    Int                       @default(0)
  busyRefreshLeaseUntil  DateTime?
  busyRefreshLeaseToken  String?
  disconnectRequestedAt  DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  projections            CalendarEventProjection[]
  busyIntervals          CalendarBusyInterval[]

  @@unique([provider, providerAccountId])
  @@index([status, busyCheckEnabled, busyRefreshAfter, busyRefreshLeaseUntil], map: "CalendarConnection_busy_refresh_idx")
}

/// Short-lived PKCE handshake state. Only a SHA-256 state digest is retained;
/// the verifier is encrypted and the row is bound to both the account and the
/// exact browser session that initiated the flow.
model CalendarOAuthAttempt {
  id                     String      @id @default(cuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  authSessionId          String
  authSession            AuthSession @relation(fields: [authSessionId], references: [id], onDelete: Cascade)
  stateDigest            String      @unique
  codeVerifierCiphertext String
  returnTo               String
  expiresAt              DateTime
  consumedAt             DateTime?
  createdAt              DateTime    @default(now())

  @@index([userId, expiresAt])
  @@index([authSessionId, expiresAt])
}

/// A grant issued during OAuth is retained here until its connection and
/// initial sync outbox commit together. Failed callbacks can therefore retry
/// revocation without retaining plaintext or depending on the user surviving.
model CalendarRevocationJob {
  id              String    @id @default(cuid())
  provider        String    @default("GOOGLE")
  tokenCiphertext String
  attempts        Int       @default(0)
  availableAt     DateTime  @default(now())
  leasedUntil     DateTime?
  leaseToken      String?
  lastErrorCode   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([availableAt, leasedUntil], map: "CalendarRevocationJob_available_idx")
}

/// The remote event materialized for one Courtly booking in one person's
/// primary calendar. The deterministic provider ID makes retries idempotent.
model CalendarEventProjection {
  id                String             @id @default(cuid())
  connectionId      String
  connection        CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  providerEventId   String
  providerEtag      String?
  syncedRevision    Int
  cleanupAttempts   Int                @default(0)
  cleanupAfter      DateTime           @default(now())
  cleanupLeaseUntil DateTime?
  cleanupLeaseToken String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([connectionId, bookingId])
  @@unique([connectionId, providerEventId])
  @@index([bookingId])
  @@index([bookingId, cleanupAfter, cleanupLeaseUntil], map: "CalendarEventProjection_cleanup_idx")
}

/// At most one coalescing outbox row exists per booking. A short lease lets
/// multiple API processes run workers without processing the same row.
model CalendarSyncJob {
  id                String    @id @default(cuid())
  bookingId         String    @unique
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedRevision Int
  attempts          Int       @default(0)
  availableAt       DateTime  @default(now())
  leasedUntil       DateTime?
  leaseToken        String?
  lastErrorCode     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([availableAt, leasedUntil])
}

/// Privacy-minimized external availability. Event identity, title, attendees,
/// and descriptions are deliberately discarded after the intervals are read.
model CalendarBusyInterval {
  id           String             @id @default(cuid())
  connectionId String
  connection   CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  startAt      DateTime
  endAt        DateTime
  expiresAt    DateTime

  @@index([connectionId, startAt, endAt])
  @@index([expiresAt])
}

model Participant {
  id                       String           @id @default(cuid())
  bookingId                String
  booking                  Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  studentId                String
  /// The database requires this student to share the booking's business.
  student                  Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attendance               String           @default("UNMARKED")
  paid                     Boolean          @default(false)
  /// Integer minor units (cents), snapshotted for this participant.
  price                    Int
  notes                    String           @default("")
  packageId                String?
  /// A composite relation pins package ownership to this student. Because the
  /// student is tenant-pinned to the booking, package tenancy follows too.
  package                  LessonPackage?   @relation(fields: [packageId, studentId], references: [id, studentId], onDelete: NoAction, onUpdate: NoAction)
  creditConsumed           Boolean          @default(false)
  cancelledAt              DateTime?
  managementTokenHash      String?          @unique
  managementTokenExpiresAt DateTime?
  managementTokenRevokedAt DateTime?
  paymentIntents           PaymentIntent[]
  feedback                 SessionFeedback?

  @@unique([bookingId, studentId])
  @@index([packageId, studentId])
}

model Payment {
  id               String          @id @default(cuid())
  businessId       String
  business         Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Present only when this is money received from a student. Coach payouts
  /// have no student party. Including businessId in the relation prevents a
  /// ledger row from naming a student owned by another tenant.
  studentId        String?
  student          Student?        @relation(fields: [studentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  bookingId        String?
  /// A student receipt may target this booking only when the named student is
  /// one of its participants. A payment cannot target a booking and package.
  booking          Booking?        @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  packageId        String?
  /// A package receipt must name the same student who owns the package.
  package          LessonPackage?  @relation(fields: [packageId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Which leg of the money path this record represents. Club lessons are
  /// STUDENT_TO_CLUB followed by CLUB_TO_COACH; a solo coach's own student
  /// pays STUDENT_TO_COACH.
  kind             String          @default("STUDENT_TO_CLUB")
  /// Set only for a CLUB_TO_COACH payout. Restrict deletion so an auditable
  /// payout can never silently lose the coach it names, and include businessId
  /// so the payee must be on this tenant's roster.
  instructorId     String?
  instructor       Instructor?     @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Integer minor units (cents).
  amount           Int
  method           String          @default("BANK_TRANSFER")
  note             String          @default("")
  paidAt           DateTime        @default(now())
  /// A recorded payment is reversed rather than deleted so the correction
  /// stays auditable. Reversed rows are excluded from every balance.
  reversedAt       DateTime?
  reversedByUserId String?
  recordedByUserId String?
  reversedReason   String          @default("")
  /// The successful simulated checkout that produced this ledger row. Offline
  /// payments remain null, and uniqueness keeps one ledger result per intent.
  paymentIntentId  String?         @unique
  paymentIntent    PaymentIntent?  @relation(fields: [paymentIntentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  refunds          PaymentRefund[]
  receipt          PaymentReceipt?

  @@unique([id, businessId])
  @@unique([paymentIntentId, businessId])
  @@index([businessId])
  @@index([instructorId])
  @@index([bookingId, studentId])
  @@index([packageId, studentId])
}

/// Idempotent simulated checkout state. The subject columns identify what the
/// customer is buying; packageId and payment are results created on success.
model PaymentIntent {
  id                                String             @id @default(cuid())
  userId                            String
  user                              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessId                        String
  business                          Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// "PACKAGE", "BOOKING" or "RENTAL". SQL enforces its matching
  /// target shape, including reservation-less failed rental attempts.
  kind                              String
  packageOfferId                    String?
  packageOffer                      PackageOffer?      @relation(fields: [packageOfferId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  participantId                     String?
  participant                       Participant?       @relation(fields: [participantId], references: [id], onDelete: Restrict)
  reservationId                     String?
  reservation                       VenueReservation?  @relation(fields: [reservationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Purchased package entitlement produced by a successful package intent.
  packageId                         String?
  package                           LessonPackage?     @relation(fields: [packageId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  /// Integer minor units (cents).
  amount                            Int
  currency                          String             @default("SGD")
  status                            String             @default("REQUIRES_CONFIRMATION")
  provider                          String             @default("SIMULATED_STRIPE")
  providerAccountReference          String             @default("")
  providerReference                 String?
  checkoutSnapshot                  Json?
  /// Affirmative, transaction-specific acceptance. Historical and explicitly
  /// simulated records may be null; live checkout creation requires the full
  /// set and SQL keeps it immutable with the checkout snapshot.
  acceptedAt                        DateTime?
  acceptedTermsVersion              String?
  acceptedTermsHash                 String?
  acceptedCancellationPolicyVersion String?
  acceptedCancellationPolicyHash    String?
  acceptedPackageTermsVersion       String?
  acceptedPackageTermsHash          String?
  acceptedReviewHash                String?
  acceptanceSessionFingerprint      String?
  acceptanceRequestFingerprint      String?
  acceptanceEvidenceVersion         Int?
  /// Safe provider evidence only. No card number, CVC, or raw provider body.
  providerChargeReference           String?
  authenticationEvidence            Json?
  idempotencyKey                    String
  expiresAt                         DateTime?
  failureCode                       String?
  lastProviderEventAt               DateTime?
  createdAt                         DateTime           @default(now())
  confirmedAt                       DateTime?
  failedAt                          DateTime?
  payment                           Payment?
  refunds                           PaymentRefund[]
  settlement                        PaymentSettlement?
  riskCases                         PaymentRiskCase[]
  receipt                           PaymentReceipt?

  @@unique([id, businessId])
  @@unique([userId, idempotencyKey])
  @@unique([provider, providerAccountReference, providerReference])
  @@unique([provider, providerAccountReference, providerChargeReference])
  @@index([businessId, status, createdAt])
  @@index([packageOfferId])
  @@index([participantId])
  @@index([reservationId])
  @@index([packageId])
}

model BusinessPaymentAccount {
  id                 String    @id @default(cuid())
  businessId         String    @unique
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider           String    @default("STRIPE")
  providerAccountId  String    @unique
  onboardingState    String    @default("PENDING")
  chargesEnabled     Boolean   @default(false)
  payoutsEnabled     Boolean   @default(false)
  detailsSubmitted   Boolean   @default(false)
  settlementCurrency String
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PaymentProviderEvent {
  id                       String    @id @default(cuid())
  businessId               String?
  business                 Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  provider                 String
  providerAccountReference String    @default("")
  providerEventId          String
  eventType                String
  payloadHash              String
  providerCreatedAt        DateTime?
  receivedAt               DateTime  @default(now())
  processedAt              DateTime?
  attempts                 Int       @default(0)
  availableAt              DateTime  @default(now())
  leasedUntil              DateTime?
  leaseToken               String?
  lastErrorCode            String?

  @@unique([provider, providerAccountReference, providerEventId])
  @@index([processedAt, availableAt, leasedUntil])
}

model PaymentRefund {
  id                String        @id @default(cuid())
  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  paymentIntentId   String
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  paymentId         String?
  payment           Payment?      @relation(fields: [paymentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  amount            Int
  status            String        @default("PENDING")
  reason            String
  providerRefundId  String?       @unique
  requestedByUserId String?
  requestedBy       User?         @relation("PaymentRefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  failureCode       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  succeededAt       DateTime?

  @@index([businessId, status, createdAt])
  @@index([paymentIntentId])
}

/// Immutable customer-facing evidence issued for a successful live package or
/// Class payment. Merchant, purchaser, and item objects are copied from the
/// accepted checkout review. Current refund state is derived from the linked
/// ledger and refund records instead of rewriting this original document.
model PaymentReceipt {
  id                   String        @id @default(cuid())
  receiptNumber        String        @unique
  documentVersion      Int           @default(1)
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  businessId           String
  business             Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentIntentId      String        @unique
  paymentIntent        PaymentIntent @relation(fields: [paymentIntentId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  paymentId            String        @unique
  payment              Payment       @relation(fields: [paymentId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  kind                 String
  amount               Int
  currency             String
  paymentProvider      String
  checkoutReviewHash   String
  merchantSnapshot     Json
  purchaserSnapshot    Json
  itemSnapshot         Json
  platformSnapshot     Json
  cancellationSnapshot Json
  policiesSnapshot     Json
  issuedAt             DateTime      @default(now())

  @@unique([id, businessId])
  @@unique([paymentIntentId, businessId])
  @@unique([paymentId, businessId])
  @@index([userId, issuedAt])
  @@index([businessId, issuedAt])
}

/// Operational record for a Stripe dispute, pre-dispute inquiry, or early
/// fraud warning. Raw webhook/card data is deliberately not retained here.
model PaymentRiskCase {
  id                       String         @id @default(cuid())
  businessId               String
  business                 Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentIntentId          String?
  paymentIntent            PaymentIntent? @relation(fields: [paymentIntentId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  provider                 String         @default("STRIPE")
  providerAccountReference String
  providerCaseId           String
  kind                     String
  status                   String
  reason                   String         @default("")
  amount                   Int?
  currency                 String?
  responseDueAt            DateTime?
  ownerUserId              String?
  owner                    User?          @relation("PaymentRiskCaseOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  providerCreatedAt        DateTime?
  lastProviderEventAt      DateTime
  resolvedAt               DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([provider, providerAccountReference, providerCaseId])
  @@index([businessId, status, responseDueAt])
  @@index([paymentIntentId])
  @@index([ownerUserId, status])
}

model PaymentSettlement {
  id                   String        @id @default(cuid())
  paymentIntentId      String        @unique
  paymentIntent        PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  providerChargeId     String?       @unique
  balanceTransactionId String?       @unique
  gross                Int
  fee                  Int
  net                  Int
  currency             String
  availableOn          DateTime?
  payoutId             String?
  payoutStatus         String?
  reconciliationStatus String        @default("PENDING")
  lastCheckedAt        DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Notification {
  id                 String             @id @default(cuid())
  businessId         String
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  instructorId       String?
  /// Drives the icon and grouping in the workspace alerts view. See
  /// notificationTypes in backend/src/notifications.ts for the vocabulary.
  type               String             @default("NOTICE")
  bookingId          String?
  integrityFlagId    String?
  integrityFlag      IntegrityFlag?     @relation(fields: [integrityFlagId], references: [id], onDelete: SetNull)
  title              String
  message            String
  read               Boolean            @default(false)
  actionNeeded       Boolean            @default(false)
  createdAt          DateTime           @default(now())
  outboundDeliveries OutboundDelivery[]

  @@index([businessId])
  @@index([businessId, read])
  @@index([integrityFlagId])
}

// Student-facing account alerts are deliberately separate from provider
// workspace notifications. An account can therefore only read its own alerts,
// while deleting a business or booking preserves the historical alert text.
model AccountNotification {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId         String?
  business           Business?          @relation(fields: [businessId], references: [id], onDelete: SetNull)
  bookingId          String?
  booking            Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  /// Optional package subject for credit-balance and expiry reminders. It is
  /// also the reminder worker's per-package deduplication key.
  packageId          String?
  package            LessonPackage?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  type               String
  title              String
  message            String
  read               Boolean            @default(false)
  actionNeeded       Boolean            @default(false)
  createdAt          DateTime           @default(now())
  outboundDeliveries OutboundDelivery[]

  @@index([userId, createdAt])
  @@index([packageId, type])
  @@index([businessId])
  @@index([bookingId])
}

model NotificationPreference {
  userId                    String    @id
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailTransactionalEnabled Boolean   @default(true)
  emailReminderEnabled      Boolean   @default(true)
  emailActionNeededEnabled  Boolean   @default(true)
  emailMarketingEnabled     Boolean   @default(false)
  emailSuppressedAt         DateTime?
  emailSuppressionReason    String?
  updatedAt                 DateTime  @updatedAt
}

model OutboundDelivery {
  id                    String               @id @default(cuid())
  channel               String               @default("EMAIL")
  eventType             String
  eventVersion          Int                  @default(1)
  dedupeKey             String
  recipientKey          String
  recipientUserId       String?
  recipientUser         User?                @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientEmail        String
  recipientName         String
  businessId            String?
  business              Business?            @relation(fields: [businessId], references: [id], onDelete: SetNull)
  bookingId             String?
  booking               Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  notificationId        String?
  notification          Notification?        @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  accountNotificationId String?
  accountNotification   AccountNotification? @relation(fields: [accountNotificationId], references: [id], onDelete: SetNull)
  template              String
  payload               Json
  status                String               @default("QUEUED")
  attempts              Int                  @default(0)
  availableAt           DateTime             @default(now())
  leasedUntil           DateTime?
  leaseToken            String?
  providerMessageId     String?
  acceptedAt            DateTime?
  deliveredAt           DateTime?
  failedAt              DateTime?
  lastErrorCode         String?
  lastErrorAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([channel, dedupeKey, recipientKey])
  @@index([status, availableAt, leasedUntil])
  @@index([recipientUserId, createdAt])
  @@index([businessId, createdAt])
  @@index([bookingId])
}

// A reschedule is a negotiation, not a unilateral edit. Either side proposes a
// new time; the other side accepts before the booking actually moves. The
// coach's rescheduleNoticeHours bounds how late a request may still be made.
model RescheduleRequest {
  id                String    @id @default(cuid())
  businessId        String
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId         String
  /// A deferred composite foreign key pins the request to this booking's business.
  booking           Booking   @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  /// "STUDENT", "COACH" or "CLUB". Who asked for the change.
  /// New or retargeted rows require a requester account with live authority:
  /// STUDENT requires an active participantId, while provider roles forbid one
  /// and require an active matching affiliation or named staff grant. Historical null requesters,
  /// later cancellation and later affiliation deactivation remain preserved.
  requestedByRole   String
  requestedByUserId String?
  /// The participant the request belongs to when a student raised it.
  participantId     String?
  proposedStartAt   DateTime
  proposedEndAt     DateTime
  originalStartAt   DateTime
  message           String    @default("")
  /// "PENDING", "ACCEPTED", "DECLINED", "WITHDRAWN" or "EXPIRED".
  status            String    @default("PENDING")
  respondedByUserId String?
  respondedAt       DateTime?
  responseMessage   String    @default("")
  createdAt         DateTime  @default(now())

  @@index([businessId, status])
  @@index([bookingId, status])
}

// Club safeguard. A coach and a student who first met through a club, and who
// later book privately outside it, are surfaced to that club for review rather
// than being blocked: the platform reports, a human decides.
model IntegrityFlag {
  id                  String         @id @default(cuid())
  /// The club that introduced the pair and may have been bypassed.
  businessId          String
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// The club's own roster entry for the coach involved.
  instructorId        String?
  instructor          Instructor?    @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  coachUserId         String
  studentUserId       String
  coachName           String
  studentName         String
  /// The private booking outside the club that triggered the flag.
  bookingId           String?
  booking             Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  outsideBusinessId   String?
  outsideBusinessName String         @default("")
  type                String         @default("PRIVATE_SESSION_AFTER_CLUB")
  /// "OPEN", "REVIEWING", "DISMISSED" or "UPHELD".
  status              String         @default("OPEN")
  detail              String         @default("")
  occurrences         Int            @default(1)
  firstSeenAt         DateTime       @default(now())
  lastSeenAt          DateTime       @default(now())
  resolvedAt          DateTime?
  resolvedByUserId    String?
  resolutionNote      String         @default("")
  notifications       Notification[]

  @@unique([businessId, coachUserId, studentUserId, type])
  @@index([businessId, status])
}

// SESSION membership remains derived from the booking. ACCOUNT conversations
// persist their direct participants and any club-assigned coach explicitly.
model ChatThread {
  id              String             @id @default(cuid())
  /// "SESSION" is booking-derived; "ACCOUNT" is a direct account conversation.
  kind            String             @default("SESSION")
  /// Null for global ACCOUNT conversations. Thread identity is immutable.
  businessId      String?
  business        Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId       String?            @unique
  booking         Booking?           @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  /// Canonical sorted pair of base account IDs for an ACCOUNT conversation.
  directKey       String?            @unique
  lastMessageAt   DateTime           @default(now())
  /// The session start the day-before reminder was posted for. A reschedule
  /// moves the booking's startAt, so a moved session is reminded again.
  reminderStartAt DateTime?
  createdAt       DateTime           @default(now())
  messages        ChatMessage[]
  readStates      ChatReadState[]
  members         ChatThreadMember[]
  proposals       SessionProposal[]
  safetyReports   ChatSafetyReport[]

  scheduleDismissals ChatScheduleDismissal[]

  @@unique([id, businessId])
  @@unique([bookingId, businessId])
  @@index([businessId, lastMessageAt])
  @@index([lastMessageAt])
}

/// Persisted membership belongs only to ACCOUNT conversations. INITIATOR and
/// TARGET are the immutable direct pair; a club may temporarily assign one
/// rostered coach through CLUB_ASSIGNED. SQL owns the cross-row invariants and
/// the partial uniqueness rule for the active assignment.
model ChatThreadMember {
  threadId      String
  thread        ChatThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("ChatThreadMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  /// "INITIATOR", "TARGET", or "CLUB_ASSIGNED".
  source        String
  membershipId  String?
  membership    Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())
  removedAt     DateTime?
  addedByUserId String?
  addedBy       User?       @relation("ChatThreadMemberAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@id([threadId, userId])
  @@index([userId, removedAt])
  @@index([membershipId])
  @@index([addedByUserId])
}

/// One line in a session chat. TEXT rows are written by people, SYSTEM rows
/// describe a lifecycle event (reminders, confirmations) and PROPOSAL rows
/// carry a next-session proposal card.
model ChatMessage {
  id            String             @id @default(cuid())
  threadId      String
  thread        ChatThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// "TEXT", "SYSTEM" or "PROPOSAL".
  kind          String             @default("TEXT")
  /// The lifecycle event behind a SYSTEM row, such as "OPENED" or "REMINDER".
  event         String             @default("")
  /// The person who wrote the message or whose action produced the event.
  /// SQL adds a SET NULL foreign key to User; the name is snapshotted so
  /// history still reads correctly after an account is renamed or removed.
  senderUserId  String?
  /// "STUDENT", "COACH", "CLUB" or "SYSTEM".
  senderRole    String
  senderName    String             @default("")
  body          String
  proposalId    String?
  proposal      SessionProposal?   @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  safetyReports ChatSafetyReport[]

  @@index([threadId, createdAt])
  @@index([proposalId])
}

/// A private, directional contact choice. Reciprocal blocks are distinct so
/// each person can remove only the block that they created.
model ChatAccountBlock {
  blockerUserId String
  blocker       User     @relation("ChatAccountBlockBlocker", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUserId String
  blocked       User     @relation("ChatAccountBlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@id([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

/// A retained safeguarding case whose evidence is snapshotted at intake.
/// Source records may later be removed, but SQL permits their foreign keys to
/// change only from a concrete ID to null and never rewrites the snapshot.
model ChatSafetyReport {
  id                 String                 @id @default(cuid())
  threadId           String?
  thread             ChatThread?            @relation(fields: [threadId], references: [id], onDelete: SetNull)
  messageId          String?
  message            ChatMessage?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  businessId         String?
  business           Business?              @relation(fields: [businessId], references: [id], onDelete: SetNull)
  bookingId          String?
  booking            Booking?               @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  reporterUserId     String?
  reporter           User?                  @relation("ChatSafetyReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  subjectUserId      String?
  subject            User?                  @relation("ChatSafetyReportSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  category           String
  status             String                 @default("OPEN")
  severity           String
  childInvolved      Boolean                @default(false)
  description        String                 @default("")
  evidence           Json
  evidenceHash       String
  /// Stable identity for a club-side SELF assignment. assignedTo remains the
  /// display snapshot and supports platform-only team labels.
  assignedClubUserId String?
  assignedClubUser   User?                  @relation("ChatSafetyReportClubAssignee", fields: [assignedClubUserId], references: [id], onDelete: SetNull)
  assignedTo         String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  auditEvents        ChatSafetyAuditEvent[]

  @@index([status, severity, createdAt])
  @@index([businessId, status, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([threadId, createdAt])
  @@index([messageId])
  @@index([bookingId])
  @@index([businessId, assignedClubUserId, status, createdAt], map: "ChatSafetyReport_assignee_status_createdAt_idx")
}

/// Immutable named-actor history for every safeguarding case decision.
model ChatSafetyAuditEvent {
  id                 String           @id @default(cuid())
  reportId           String
  report             ChatSafetyReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  actorKind          String
  actorUserId        String?
  actor              User?            @relation("ChatSafetyAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorName          String
  action             String
  note               String?
  fromStatus         String?
  toStatus           String?
  fromSeverity       String?
  toSeverity         String?
  assignedTo         String?
  /// Stable assignment snapshot; no foreign key so deletion cannot rewrite
  /// retained ownership history.
  assignedClubUserId String?
  createdAt          DateTime         @default(now())

  @@index([reportId, createdAt])
  @@index([actorUserId, createdAt])
}

/// How far one person has read one thread. Unread counts are derived from
/// this rather than stored, so they cannot drift from the messages.
model ChatReadState {
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// SQL adds a cascading foreign key to User.
  userId     String
  lastReadAt DateTime   @default(now())

  @@id([threadId, userId])
  @@index([userId])
}

/// One person's dismissal of the session the chat detected. Only the latest
/// matters: a new message produces a new suggestion key, so the card returns
/// when the plan changes. Saved server-side so a dismissal follows the person
/// across devices.
model ChatScheduleDismissal {
  threadId      String
  thread        ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// SQL adds a cascading foreign key to User.
  userId        String
  suggestionKey String
  dismissedAt   DateTime   @default(now())

  @@id([threadId, userId])
  @@index([userId])
}

/// A next session proposed from a chat. Nothing is booked until the other
/// side accepts; an edit closes this proposal and sends a new one back the
/// other way, so the person who asked first confirms the final time.
model SessionProposal {
  id                  String                    @id @default(cuid())
  businessId          String
  business            Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  threadId            String
  thread              ChatThread                @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// The selected Class, coach and venue are pinned to this business with
  /// composite foreign keys.
  serviceId           String
  service             Service                   @relation(fields: [serviceId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  instructorId        String
  instructor          Instructor                @relation(fields: [instructorId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  locationId          String
  location            Location                  @relation(fields: [locationId, businessId], references: [id, businessId], onDelete: Restrict, onUpdate: NoAction)
  address             String                    @default("")
  /// Agreed integer minor-unit price and currency at proposal creation.
  price               Int
  currency            String
  startAt             DateTime
  endAt               DateTime
  /// "STUDENT" or "COACH". A club account can read proposals but never
  /// raises or answers one.
  proposedByRole      String
  /// SQL adds a SET NULL foreign key to User.
  proposedByUserId    String?
  proposedByName      String
  /// The one student this proposal books. Null only for a coach's proposal
  /// to a whole group, where each student answers for themselves. SQL adds a
  /// cascading foreign key to User.
  targetStudentUserId String?
  targetStudentName   String                    @default("")
  counterOfId         String?
  counterOf           SessionProposal?          @relation("SessionProposalCounter", fields: [counterOfId], references: [id], onDelete: SetNull)
  counters            SessionProposal[]         @relation("SessionProposalCounter")
  message             String                    @default("")
  /// "OPEN", "ACCEPTED", "DECLINED", "COUNTERED", "WITHDRAWN" or, for a
  /// group proposal every student has answered, "CLOSED".
  status              String                    @default("OPEN")
  closedAt            DateTime?
  createdAt           DateTime                  @default(now())
  responses           SessionProposalResponse[]
  messages            ChatMessage[]

  @@index([threadId, status])
  @@index([businessId])
  @@index([counterOfId])
}

/// One student's answer to a proposal. The unique pair makes a double
/// acceptance impossible even if two requests race past the proposal lock.
model SessionProposalResponse {
  id              String          @id @default(cuid())
  proposalId      String
  proposal        SessionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  /// The student the answer books or declines. SQL adds a cascading
  /// foreign key to User.
  studentUserId   String
  studentName     String
  /// Who pressed the button: the student, or the coach answering a
  /// student's own proposal. SQL adds a SET NULL foreign key to User.
  responderUserId String?
  /// "ACCEPTED", "DECLINED" or "COUNTERED".
  status          String
  /// The Class booked by an acceptance.
  bookingId       String?
  booking         Booking?        @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())

  @@unique([proposalId, studentUserId])
  @@index([bookingId])
}

/// Coach-to-learner feedback for one attended place in a Class. SHARED
/// feedback is visible to the student (or an authorized guardian of a managed
/// child); PRIVATE drafts and clubNote stay inside the club workspace.
model SessionFeedback {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId     String
  booking       Booking     @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  /// SQL also requires this participant to belong to bookingId.
  participantId String      @unique
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  authorUserId  String?
  author        User?       @relation("SessionFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  /// Immutable snapshots of who first wrote the feedback.
  authorName    String
  authorRole    String
  editedByName  String?
  visibility    String      @default("PRIVATE")
  summary       String      @default("")
  strengths     String      @default("")
  focusAreas    String      @default("")
  nextGoal      String      @default("")
  /// Internal remark for club staff. Never serialized to students or guardians.
  clubNote      String      @default("")
  /// First time the feedback became visible to the learner.
  sharedAt      DateTime?
  firstViewedAt DateTime?
  editedAt      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId, sharedAt])
  @@index([bookingId])
}

/// A student's place in the queue for one full group Class occurrence. Order
/// is the database-assigned sequence; an OFFERED row holds one place until
/// offerExpiresAt so a public booking cannot take it first.
model WaitlistEntry {
  id             String    @id @default(cuid())
  sequence       Int       @default(autoincrement())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId      String
  booking        Booking   @relation(fields: [bookingId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  studentId      String
  student        Student   @relation(fields: [studentId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  status         String    @default("WAITING")
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  respondedAt    DateTime?
  closedReason   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([sequence])
  @@index([bookingId, status, sequence])
  @@index([studentId, status])
  @@index([status, offerExpiresAt])
}

/// Append-only package credit history written by a LessonPackage trigger, so
/// every balance change is captured whichever code path made it. Application
/// writers label the change through the transaction-local
/// courtly.credit_context setting (see credit-ledger.ts).
model PackageCreditEvent {
  id            String        @id @default(cuid())
  sequence      Int           @default(autoincrement())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  packageId     String
  package       LessonPackage @relation(fields: [packageId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  studentId     String
  kind          String
  delta         Int
  totalAfter    Int
  usedAfter     Int
  bookingId     String?
  participantId String?
  reservationId String?
  actorUserId   String?
  note          String        @default("")
  createdAt     DateTime      @default(now())

  @@unique([sequence])
  @@index([packageId, sequence])
  @@index([businessId, createdAt])
}

/// A club-local training cohort, such as a weekly junior squad. It is an
/// operational roster, never an account type or a teaching affiliation.
model TrainingGroup {
  id           String                @id @default(cuid())
  businessId   String
  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  sport        String                @default("")
  level        String                @default("")
  ageBand      String                @default("")
  description  String                @default("")
  scheduleNote String                @default("")
  capacity     Int?
  /// Optional scheduling defaults. The API validates them inside businessId;
  /// a later-archived default is simply ignored.
  serviceId    String?
  locationId   String?
  instructorId String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  members      TrainingGroupMember[]

  @@unique([id, businessId])
  @@index([businessId, active])
}

model TrainingGroupMember {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  groupId    String
  group      TrainingGroup @relation(fields: [groupId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  studentId  String
  student    Student       @relation(fields: [studentId, businessId], references: [id, businessId], onDelete: Cascade, onUpdate: NoAction)
  active     Boolean       @default(true)
  joinedAt   DateTime      @default(now())
  leftAt     DateTime?

  @@unique([groupId, studentId])
  @@index([businessId, studentId])
}

/// A student's saved club. Only the account itself can read or change it.
model FavoriteClub {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, businessId])
  @@index([businessId])
}

/// Aggregate, person-free daily funnel counters for one club. No account,
/// session, device, or request identifier is stored.
model ClubFunnelCounter {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date
  metric     String
  count      Int      @default(0)

  @@id([businessId, day, metric])
}
